# Copiar a .env en la PC servidor (Windows)

# PostgreSQL local en la misma PC
DATABASE_URL=postgresql://mt_user:tu_password@localhost:5432/mt_db

# API
PORT=3000
HOST=0.0.0.0

# Orígenes permitidos (frontend). Usar IP fija del servidor en LAN.
# Ejemplo si Caddy sirve en http://192.168.1.50
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://192.168.1.50

JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Opcional: correo (si no hay internet en el local, crear admins verificados en DB)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
