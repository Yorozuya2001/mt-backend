# Copiar a .env (desarrollo local)

# SQLite (archivo local; Electron usa %APPDATA%\MT Shop\data)
DATABASE_URL=file:./data/mt.sqlite
MT_DATA_DIR=./data

# API
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
APP_VERSION=0.1.0

# Frontend dev (Vite)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT access (corto)
JWT_ACCESS_SECRET=cambiar_por_secreto_largo_aleatorio_access
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token (cookie httpOnly)
JWT_REFRESH_EXPIRES_IN=400d
REFRESH_COOKIE_NAME=mt_refresh
COOKIE_SECURE=false

# Escritorio: usuarios iniciales (seed)
# BOOTSTRAP_ADMIN_EMAIL=superadmin@mtshop.local
# BOOTSTRAP_ADMIN_PASSWORD=
# SEED_DESKTOP=true

# Desarrollo: password para admins de prueba (staff.seed)
# STAFF_DEV_PASSWORD=

# Correo (opcional en local)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MT SHOP <noreply@mt.local>"

# Producción LAN / Electron: Nest sirve el build del front
# FRONTEND_DIST_PATH=../mt-front/dist
# MT_DESKTOP=1

# Límite global de requests (login sigue en 5 / 15 min)
THROTTLE_LIMIT=1000
