# Copiar a .env en la PC servidor (Windows)

# PostgreSQL local (Docker en puerto 5433)
DATABASE_URL=postgresql://axel:tu_password@localhost:5433/mt_db?schema=public

# API
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Orígenes permitidos (frontend). Reemplazar 192.168.1.50 por la IP LAN del servidor.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.50:3000
APP_URL=http://192.168.1.50:3000

JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d

# Correo (opcional en local sin internet; dejar SMTP_USER/SMTP_PASS vacíos)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MT SHOP <noreply@mt.local>"

# Ruta al build del frontend (producción LAN)
FRONTEND_DIST_PATH=../mt-front/dist
