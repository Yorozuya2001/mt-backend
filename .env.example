# Copiar a .env (desarrollo local)

# PostgreSQL
DATABASE_URL=postgresql://mt_user:changeme@localhost:5433/mt_db?schema=public

# API
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Frontend dev (Vite)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT access (corto)
JWT_ACCESS_SECRET=cambiar_por_secreto_largo_aleatorio_access
JWT_ACCESS_EXPIRES_IN=15m

# Legacy fallback (solo si JWT_ACCESS_SECRET no está definido)
# JWT_SECRET=
# JWT_EXPIRES_IN=1d

# Refresh token (cookie httpOnly)
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=mt_refresh
# COOKIE_DOMAIN=

# Bootstrap único en producción (borrar después del primer deploy)
# BOOTSTRAP_ADMIN_EMAIL=admin@tudominio.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Desarrollo: password para admins de prueba (staff.seed)
# STAFF_DEV_PASSWORD=

# Correo (opcional)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MT SHOP <noreply@mt.local>"

# Producción LAN (opcional): Nest sirve el build del front
# FRONTEND_DIST_PATH=../MT-Frontend/dist

# Docker compose local
POSTGRES_USER=mt_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mt_db
